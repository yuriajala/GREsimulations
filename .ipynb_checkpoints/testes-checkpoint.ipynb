    "def func_V7(x, a,b,c,d,e,f,g):\n",
    "    return np.absolute(a*np.exp(-x/0.030)*np.exp((2.*np.pi*1j*5.3*magField*hydroGyro/1e6)*x) + \n",
    "                       b*np.exp(-x/0.040)*np.exp((2.*np.pi*1j*4.2*magField*hydroGyro/1e6)*x) + \n",
    "                       c*np.exp(-x/0.051)*np.exp((2.*np.pi*1j*2.75*magField*hydroGyro/1e6)*x) + \n",
    "                       d*np.exp(-x/0.052)*np.exp((2.*np.pi*1j*2.1*magField*hydroGyro/1e6)*x) + \n",
    "                       e*np.exp(-x/0.062)*np.exp((2.*np.pi*1j*1.3*magField*hydroGyro/1e6)*x) +\n",
    "                       f*np.exp(-x/0.083)*np.exp((2.*np.pi*1j*0.9*magField*hydroGyro/1e6)*x) +\n",
    "                       g*np.exp(-x/0.023)*np.exp((2.*np.pi*1j*4.7*magField*hydroGyro/1e6)*x))\n",
    "\n",
    "bd = (0, [1., 1., 1., 1., 1., 1., 1.]) # Bounds\n",
    "popt, pcov = curve_fit(lambda t,a,b,c,d,e,f,g: np.absolute(a*np.exp(-t/0.030)*np.exp((2.*np.pi*1j*5.3*magField*hydroGyro/1e6)*t)+ \n",
    "                                                         b*np.exp(-t/0.040)*np.exp((2.*np.pi*1j*4.2*magField*hydroGyro/1e6)*t)+ \n",
    "                                                         c*np.exp(-t/0.051)*np.exp((2.*np.pi*1j*2.75*magField*hydroGyro/1e6)*t)+ \n",
    "                                                         d*np.exp(-t/0.052)*np.exp((2.*np.pi*1j*2.1*magField*hydroGyro/1e6)*t)+ \n",
    "                                                         e*np.exp(-t/0.062)*np.exp((2.*np.pi*1j*1.3*magField*hydroGyro/1e6)*t)+\n",
    "                                                         f*np.exp(-t/0.083)*np.exp((2.*np.pi*1j*0.9*magField*hydroGyro/1e6)*t)+\n",
    "                                                         g*np.exp(-t/0.023)*np.exp((2.*np.pi*1j*4.7*magField*hydroGyro/1e6)*t)),\n",
    "                       t,  Sfinal, bounds=bd)\n",
    "plt.plot(t,Sfinal,'bo',label='data')\n",
    "plt.plot(t, func_V7(t,*popt), 'r-', label='fit2')\n",
    "plt.show()"
