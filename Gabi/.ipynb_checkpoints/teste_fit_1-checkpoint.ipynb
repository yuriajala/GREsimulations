    "#funções para incializar\n",
    "# -*- coding: utf-8 -*-\n",
    "\n",
    "def dixon(s23,s46):\n",
    "    \n",
    "    rw = (s46 + s23)/2\n",
    "    rf = (s46 - s23)/2\n",
    "         \n",
    "    ff = rf / (rf + rw)\n",
    "    \n",
    "    return(ff)"
   ]
  },
